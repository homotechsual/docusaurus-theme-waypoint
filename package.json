{
  "name": "@homotechsual/docusaurus-theme-waypoint",
  "version": "1.0.0",
  "description": "Read long Docusaurus guides one step at a time. Adds a Whole guide / One step at a time switch to docs that opt in.",
  "main": "index.js",
  "types": "types.d.ts",
  "files": [
    "index.js",
    "types.d.ts",
    "theme",
    "lib/theme",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && copyfiles -u 1 \"theme/**/*.css\" lib/theme",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/steps.test.mjs",
    "test:e2e": "playwright test",
    "test": "yarn test:unit && yarn test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homotechsual/docusaurus-theme-waypoint.git"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-theme",
    "documentation",
    "guide",
    "steps"
  ],
  "author": "Mikey O'Toole <mikey@homotechsual.dev>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/homotechsual/docusaurus-theme-waypoint/issues"
  },
  "homepage": "https://github.com/homotechsual/docusaurus-theme-waypoint#readme",
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6",
  "peerDependencies": {
    "@docusaurus/core": ">=3.0.0 <4.0.0",
    "@docusaurus/plugin-content-docs": ">=3.0.0 <4.0.0",
    "@docusaurus/theme-common": ">=3.0.0 <4.0.0",
    "@docusaurus/utils-validation": ">=3.0.0 <4.0.0",
    "@mdx-js/react": ">=3.0.0 <4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/theme-classic": "^3.10.2",
    "@docusaurus/theme-common": "^3.10.2",
    "@docusaurus/utils-validation": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "copyfiles": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "demo"
  ],
  "publishConfig": {
    "access": "public"
  }
}
